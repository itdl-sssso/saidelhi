# Copy to deploy/.env.staging on the server (gitignored) and fill every CHANGE_ME.
# Used three ways: MySQL container env, app runtime env, and `next build` (BuildKit secret).
# Generate secrets with: openssl rand -hex 32

# --- MySQL container -----------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_USER=app
MYSQL_PASSWORD=CHANGE_ME

# --- Data ---------------------------------------------------------------
DATA_SOURCE=db
# Same password as MYSQL_PASSWORD. Host networking: MySQL is published on loopback :3307.
DATABASE_URL=mysql://app:CHANGE_ME@127.0.0.1:3307/saidelhi
# For `tools` legacy import only (mounted read-only from $SAIDELHI_DATA/imports)
LEGACY_DUMP=/imports/saidelhi-content.sql

# --- Files (container paths; host dirs under $SAIDELHI_DATA, see compose.yml) ---
MEDIA_URL=/media
APP_URL=https://staging.saidelhi.org

# --- Secrets ------------------------------------------------------------
SESSION_SECRET=CHANGE_ME
CRON_SECRET=CHANGE_ME

# --- WhatsApp: console prints OTP codes to `docker compose logs app` -----
WHATSAPP_PROVIDER=console
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v23.0
WA_DISPLAY_NUMBER=
WHATSAPP_PUBLIC_NUMBER=

# --- AI extraction (ollama needs `--profile ai`) -------------------------
EXTRACTOR_PROVIDER=rules
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=smollm2:360m
