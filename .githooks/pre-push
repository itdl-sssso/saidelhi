#!/usr/bin/env bash
# Blocks every push (the repo is public) until the dependency security gate passes.
# Enabled by `pnpm install` (package.json "prepare" sets core.hooksPath=.githooks).
# Bypass only with the user's say-so: git push --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! scripts/ci/deps-security.sh; then
  echo "pre-push: dependency security gate failed; fix every finding before pushing." >&2
  exit 1
fi
