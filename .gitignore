# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!deploy/.env.staging.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling
/graft

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
/.local-dumps
/.claude/worktrees

# drizzle-kit pull scratch output (curated into src/server/db/legacy.ts)
/.drizzle-pull/

# local media
/media/
/media-private/

# local media (legacy mount + private uploads)
/media
/media-private

# e2e
/test-results/
/playwright-report/
/tests/e2e/.cache/

# Hugging Face model weights (EXTRACTOR_PROVIDER=hf)
/.cache/

# Local-only media: licensed audio, personal interviews, transcripts (never commit)
/media-kit/

# Screenshots and raw reports stay local; commit only the summaries
/docs/feedback/shots/
/docs/seo/snapshots/*/lh_*.json

# Agent progress logs stay in the worktree; summaries go in the PR description and HANDOFF.md
/docs/progress/*
!/docs/progress/HANDOFF.md
!/docs/progress/M5-plan.md
!/docs/progress/M6-plan.md
!/docs/progress/M7-plan.md
!/docs/progress/M7-a11y-findings.md
!/docs/progress/M7-redirect-waterfall.html
