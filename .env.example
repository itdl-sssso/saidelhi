# Copy to .env.local for development (.env* files other than this one are gitignored).

# --- Data ---------------------------------------------------------------
# mock = in-memory fixtures (src/server/mock/fixtures), db = MySQL via Drizzle
DATA_SOURCE=mock
DATABASE_URL=mysql://app:app@127.0.0.1:3307/saidelhi
# Legacy saidelhi.org content dump for `pnpm db:import-legacy` (absolute, or relative to repo root)
LEGACY_DUMP=.local-dumps/saidelhi-content.sql

# --- Files --------------------------------------------------------------
MEDIA_ROOT=./media
MEDIA_PRIVATE_ROOT=./media-private
# Public URL prefix for MEDIA_ROOT files (legacy Django media)
MEDIA_URL=/media

# --- Secrets (dev values; generate real ones with `openssl rand -hex 32`) -
SESSION_SECRET=dev-session-secret-change-me-0000000000000000
CRON_SECRET=dev-cron-secret-change-me

# --- WhatsApp (docs/whatsapp-setup.md) -----------------------------------
# console = log messages to the server log; cloud = Meta WhatsApp Cloud API
WHATSAPP_PROVIDER=console
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v23.0

# --- AI extraction -------------------------------------------------------
# stub = deterministic fake drafts; ollama = local model
EXTRACTOR_PROVIDER=stub
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
